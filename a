import java.sql.*;

public class PreparedStatementCRUD {

    public static void main(String[] args) {

        try {

            // 1. Load Driver
            Class.forName("com.mysql.cj.jdbc.Driver");

            // 2. Create Connection
            Connection con = DriverManager.getConnection(
                    "jdbc:mysql://localhost:3306/jdbcschema",
                    "root",
                    "root");

            System.out.println("Database Connected Successfully");

            // ---------------------------------------------------
            // a. Create Student Table
            // ---------------------------------------------------

            String createTable = "CREATE TABLE IF NOT EXISTS student ("
                    + "rollno INT PRIMARY KEY, "
                    + "name VARCHAR(50), "
                    + "address VARCHAR(50))";

            PreparedStatement psCreate = con.prepareStatement(createTable);
            psCreate.execute();

            System.out.println("Student Table Created");

            // Insert Few Records

            String insertQuery = "INSERT INTO student VALUES (?, ?, ?)";

            PreparedStatement psInsert = con.prepareStatement(insertQuery);

            psInsert.setInt(1, 101);
            psInsert.setString(2, "Ahmed");
            psInsert.setString(3, "Hyderabad");
            psInsert.executeUpdate();

            psInsert.setInt(1, 102);
            psInsert.setString(2, "Rahul");
            psInsert.setString(3, "Delhi");
            psInsert.executeUpdate();

            System.out.println("Initial Records Inserted");

            // ---------------------------------------------------
            // b. Display Records using PreparedStatement
            // ---------------------------------------------------

            System.out.println("\n--- Student Records ---");

            String selectQuery = "SELECT * FROM student";

            PreparedStatement psSelect = con.prepareStatement(selectQuery);

            ResultSet rs = psSelect.executeQuery();

            while (rs.next()) {
                System.out.println(
                        rs.getInt("rollno") + " "
                        + rs.getString("name") + " "
                        + rs.getString("address"));
            }

            // ---------------------------------------------------
            // c. Insert Two More Records
            // ---------------------------------------------------

            psInsert.setInt(1, 103);
            psInsert.setString(2, "Kiran");
            psInsert.setString(3, "Mumbai");
            psInsert.executeUpdate();

            psInsert.setInt(1, 104);
            psInsert.setString(2, "Priya");
            psInsert.setString(3, "Chennai");
            psInsert.executeUpdate();

            System.out.println("\nTwo More Records Inserted");

            // ---------------------------------------------------
            // d. Update One Record
            // ---------------------------------------------------

            String updateQuery =
                    "UPDATE student SET address=? WHERE rollno=?";

            PreparedStatement psUpdate =
                    con.prepareStatement(updateQuery);

            psUpdate.setString(1, "Bangalore");
            psUpdate.setInt(2, 102);

            psUpdate.executeUpdate();

            System.out.println("One Record Updated");

            // ---------------------------------------------------
            // e. Delete One Record
            // ---------------------------------------------------

            String deleteQuery =
                    "DELETE FROM student WHERE rollno=?";

            PreparedStatement psDelete =
                    con.prepareStatement(deleteQuery);

            psDelete.setInt(1, 101);

            psDelete.executeUpdate();

            System.out.println("One Record Deleted");

            // ---------------------------------------------------
            // f. Display Final Records
            // ---------------------------------------------------

            System.out.println("\n--- Final Student Records ---");

            rs = psSelect.executeQuery();

            while (rs.next()) {
                System.out.println(
                        rs.getInt("rollno") + " "
                        + rs.getString("name") + " "
                        + rs.getString("address"));
            }

            // Close Connection
            con.close();

        } catch (Exception e) {
            System.out.println(e);
        }
    }
}
